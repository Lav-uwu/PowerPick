# Copy to .env. Never commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret
# JSON_FILE is relative to the project root. Local data is never publicly served.
JSON_FILE=instance/powerpick.json
APP_URL=http://127.0.0.1:5000
COOKIE_SECURE=false

# Vercel only: connect a PRIVATE Blob store. Leave empty for local JSON files.
BLOB_READ_WRITE_TOKEN=
JSON_BLOB_PATH=powerpick/database.json

# Use Razorpay test keys first; configure automatic capture in its dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional SMTP delivery. Notifications are always saved to the user's inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=PowerPick <orders@example.com>
SUPPORT_EMAIL=

# Catalog prices include the sample GST rates in data/products.json.
SHIPPING_FEE_PAISE=7900
FREE_SHIPPING_THRESHOLD_PAISE=149900
RETURN_WINDOW_DAYS=7
DEMO_PAYMENTS=true
